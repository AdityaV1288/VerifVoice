# VerifVoice — environment variables (copy to .env, or export in the shell)
# No real secrets belong in this file or in git. `.env` and `*.pem` are gitignored.

# --- Person 1: audio-authenticity adapter ---
# Adapter name: "aasist_onnx" (pretrained AASIST ONNX, MIT) or "unavailable" (honest null).
# aasist_onnx needs models/aasist.onnx (download via scripts/download_model.py or hf-mirror.com).
# LAPTOP ONLY: onnxruntime/scipy have no s390x wheels, so LinuxONE stays on "unavailable".
VERIFVOICE_ADAPTER=aasist_onnx

# Spoof classification threshold (0..1). Labels score >= threshold as "potential_spoof".
VERIFVOICE_THRESHOLD=0.5

# Model path + ONNX execution providers.
VERIFVOICE_MODEL_PATH=models/aasist.onnx
VERIFVOICE_ONNX_PROVIDERS=CPUExecutionProvider

# Input limits (bytes / seconds) and silence gate.
VERIFVOICE_MAX_FILE_BYTES=26214400
VERIFVOICE_MAX_DURATION=60
VERIFVOICE_MIN_DURATION=0.25
VERIFVOICE_MIN_RMS=0.0001
